# Copie este arquivo para .env e preencha. O .env está no .gitignore e não sai da máquina.

# URL da revisão no Parsifal, sem barra final. Copie da barra de endereço com a revisão aberta.
# Formato: https://parsif.al/<seu-usuario>/<slug-da-revisao>
PARSIFAL_REVIEW_URL=

# Acesso, caminho 1 (recomendado): usuário e senha do Parsifal.
# A automação loga sozinha e reloga quando a sessão cai.
PARSIFAL_USERNAME=
PARSIFAL_PASSWORD=

# Acesso, caminho 2: cookies de uma sessão já aberta no navegador, para quem não quer guardar senha.
# Só é usado quando usuário e senha acima estão vazios.
# No navegador logado: DevTools (F12) > Application > Cookies > parsif.al. Copie os dois valores.
# Quando o cookie expira, é preciso copiar de novo.
PARSIFAL_SESSIONID=
PARSIFAL_CSRFTOKEN=
